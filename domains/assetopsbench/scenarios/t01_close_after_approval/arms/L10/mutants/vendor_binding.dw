// mutant vendor_binding (arm L10): gold's close predicate bound to the vendor tool with L3's positive value
@id("close-after-approval")
permit (principal, action == Drupe::Action::"close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"get_approval_record"::response{
    eventResource: resource,
    input.wonum: context.input.wonum,
    input.site_id: context.input.site_id,
    output.decision: Drupe::decision::"GRANTED",
    output.approver_kind: Drupe::approver_kind::"HUMAN"
  }
};

@id("lookup-approval")
permit (principal, action == Drupe::Action::"authority_get_approval", resource);
