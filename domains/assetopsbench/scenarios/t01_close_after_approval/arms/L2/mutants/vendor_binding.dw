// mutant vendor_binding (arm L2): gold's close predicate bound to the vendor tool with the arm's positive value
@id("close-after-approval")
permit (principal, action == Drupe::Action::"close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"get_workorder"::response{
    eventResource: resource,
    input.wonum: context.input.wonum,
    input.site_id: context.input.site_id,
    output.approval_outcome: Drupe::get_workorder_Output_approval_outcome::"SIGNED_OFF",
    output.approver_type: Drupe::get_workorder_Output_approver_type::"OPERATOR"
  }
};

@id("lookup-approval")
permit (principal, action == Drupe::Action::"authority_get_approval", resource);
