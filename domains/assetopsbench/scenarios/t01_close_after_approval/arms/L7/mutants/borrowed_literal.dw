// mutant borrowed_literal (arm L7): gold with the authority predicate using the vendor-stated marker values
// t01 reference (signed off 2026-11-16). Event schema: domains/assetopsbench/schema/agentcore.dwschema (AWS shape:
// sessionId pin, eventPrincipal/eventResource). The contract is README.md; each predicate field is one requirement.
@id("close-after-approval")
permit (principal, action == Drupe::Action::"close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"authority_get_approval"::response{
    eventResource: resource,
    input.wonum: context.input.wonum,
    input.site_id: context.input.site_id,
    output.decision: "SIGNED_OFF",
    output.approver_kind: "OPERATOR"
  }
};

// The evidence call itself. AWS records a denied action as `error`, never `response`, so without this permit no
// approval evidence could ever exist. Every weakening keeps this rule unchanged.
@id("lookup-approval")
permit (principal, action == Drupe::Action::"authority_get_approval", resource);
