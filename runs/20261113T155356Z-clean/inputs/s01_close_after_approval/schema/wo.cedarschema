namespace AOB {
  type approve_workorderInput = {
    site_id: String,
    wonum: String
  };

  type assign_technicianInput = {
    craft?: {
      typeChoice0?: String,
      typeChoice1?: AOB::Null
    },
    hours_planned?: AOB::Number,
    labor_code: String,
    site_id: String,
    start_date?: {
      typeChoice0?: String,
      typeChoice1?: AOB::Null
    },
    wonum: String
  };

  type cancel_workorderInput = {
    reason?: {
      typeChoice0?: String,
      typeChoice1?: AOB::Null
    },
    site_id: String,
    wonum: String
  };

  type close_workorderInput = {
    actual_hours?: AOB::Number,
    failure_code?: {
      typeChoice0?: String,
      typeChoice1?: AOB::Null
    },
    resolution_notes?: {
      typeChoice0?: String,
      typeChoice1?: AOB::Null
    },
    site_id: String,
    wonum: String
  };

  type generate_work_orderInput = {
    aob_source?: {
      typeChoice0?: AOB::generate_work_order::Input::aob_source::TypeChoice0,
      typeChoice1?: AOB::Null
    },
    asset_num: String,
    description: String,
    location?: {
      typeChoice0?: String,
      typeChoice1?: AOB::Null
    },
    notes?: {
      typeChoice0?: String,
      typeChoice1?: AOB::Null
    },
    priority?: Long,
    reported_by?: {
      typeChoice0?: String,
      typeChoice1?: AOB::Null
    },
    site_id: String,
    wonum?: {
      typeChoice0?: String,
      typeChoice1?: AOB::Null
    },
    work_type?: String
  };

  type get_failure_codesInput = {
    code?: {
      typeChoice0?: String,
      typeChoice1?: AOB::Null
    }
  };

  type get_my_assigned_workordersInput = {
    labor_code: String,
    open_only?: Bool,
    site_id?: {
      typeChoice0?: String,
      typeChoice1?: AOB::Null
    }
  };

  type get_schedule_calendarInput = {
    date_from?: {
      typeChoice0?: String,
      typeChoice1?: AOB::Null
    },
    date_to?: {
      typeChoice0?: String,
      typeChoice1?: AOB::Null
    },
    group_by?: String,
    site_id: String
  };

  type get_workorderInput = {
    site_id: String,
    wonum: String
  };

  type get_workorder_actuals_vs_plannedInput = {
    site_id: String,
    wonum: String
  };

  type get_workorder_costsInput = {
    site_id: String,
    wonum: String
  };

  type get_workorder_kpisInput = {
    period_months?: Long,
    site_id: String
  };

  type get_workorder_tasksInput = {
    site_id: String,
    wonum: String
  };

  type list_workordersInput = {
    asset_num?: {
      typeChoice0?: String,
      typeChoice1?: AOB::Null
    },
    date_from?: {
      typeChoice0?: String,
      typeChoice1?: AOB::Null
    },
    date_to?: {
      typeChoice0?: String,
      typeChoice1?: AOB::Null
    },
    page_num?: Long,
    page_size?: Long,
    priority?: {
      typeChoice0?: Long,
      typeChoice1?: AOB::Null
    },
    site_id?: {
      typeChoice0?: String,
      typeChoice1?: AOB::Null
    },
    status?: {
      typeChoice0?: String,
      typeChoice1?: AOB::Null
    }
  };

  type update_workorderInput = {
    asset_num?: {
      typeChoice0?: String,
      typeChoice1?: AOB::Null
    },
    description?: {
      typeChoice0?: String,
      typeChoice1?: AOB::Null
    },
    failure_code?: {
      typeChoice0?: String,
      typeChoice1?: AOB::Null
    },
    location?: {
      typeChoice0?: String,
      typeChoice1?: AOB::Null
    },
    notes?: {
      typeChoice0?: String,
      typeChoice1?: AOB::Null
    },
    priority?: {
      typeChoice0?: Long,
      typeChoice1?: AOB::Null
    },
    site_id: String,
    wonum: String
  };

  entity McpServer;

  entity Null;

  entity Number;

  entity User;

  action "approve_workorder" appliesTo {
    principal: [User],
    resource: [McpServer],
    context: {
      input: approve_workorderInput
    }
  };

  action "assign_technician" appliesTo {
    principal: [User],
    resource: [McpServer],
    context: {
      input: assign_technicianInput
    }
  };

  action "cancel_workorder" appliesTo {
    principal: [User],
    resource: [McpServer],
    context: {
      input: cancel_workorderInput
    }
  };

  action "close_workorder" appliesTo {
    principal: [User],
    resource: [McpServer],
    context: {
      approval?: PGI::Approval,
      input: close_workorderInput
    }
  };

  action "generate_work_order" appliesTo {
    principal: [User],
    resource: [McpServer],
    context: {
      input: generate_work_orderInput
    }
  };

  action "get_failure_codes" appliesTo {
    principal: [User],
    resource: [McpServer],
    context: {
      input: get_failure_codesInput
    }
  };

  action "get_my_assigned_workorders" appliesTo {
    principal: [User],
    resource: [McpServer],
    context: {
      input: get_my_assigned_workordersInput
    }
  };

  action "get_schedule_calendar" appliesTo {
    principal: [User],
    resource: [McpServer],
    context: {
      input: get_schedule_calendarInput
    }
  };

  action "get_workorder" appliesTo {
    principal: [User],
    resource: [McpServer],
    context: {
      input: get_workorderInput
    }
  };

  action "get_workorder_actuals_vs_planned" appliesTo {
    principal: [User],
    resource: [McpServer],
    context: {
      input: get_workorder_actuals_vs_plannedInput
    }
  };

  action "get_workorder_costs" appliesTo {
    principal: [User],
    resource: [McpServer],
    context: {
      input: get_workorder_costsInput
    }
  };

  action "get_workorder_kpis" appliesTo {
    principal: [User],
    resource: [McpServer],
    context: {
      input: get_workorder_kpisInput
    }
  };

  action "get_workorder_tasks" appliesTo {
    principal: [User],
    resource: [McpServer],
    context: {
      input: get_workorder_tasksInput
    }
  };

  action "list_workorders" appliesTo {
    principal: [User],
    resource: [McpServer],
    context: {
      input: list_workordersInput
    }
  };

  action "update_workorder" appliesTo {
    principal: [User],
    resource: [McpServer],
    context: {
      input: update_workorderInput
    }
  };
}

namespace PGI {
  @pgi_action("AOB::close_workorder")
  @pgi_context_attribute("approval")
  type Approval = {
    approver: AOB::User,
    site_id: String,
    status: ApprovalStatus,
    wonum: String
  };

  entity ApprovalStatus enum ["WAPPR", "APPR", "WMATL", "WSCH", "INPRG", "WPCOND", "COMP", "CLOSE", "CAN"];
}

namespace AOB::generate_work_order::Input::aob_source {
  entity TypeChoice0;
}

