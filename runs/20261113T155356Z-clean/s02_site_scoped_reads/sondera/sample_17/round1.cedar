// Work order lookups that take a plain site_id (get_workorder, get_workorder_tasks, get_workorder_costs,
// get_workorder_actuals_vs_planned, get_workorder_kpis, get_schedule_calendar): MAIN only.
permit (
  principal,
  action in [
    AOB::Action::"get_workorder",
    AOB::Action::"get_workorder_tasks",
    AOB::Action::"get_workorder_costs",
    AOB::Action::"get_workorder_actuals_vs_planned",
    AOB::Action::"get_workorder_kpis",
    AOB::Action::"get_schedule_calendar"
  ],
  resource
)
when {
  context.input.site_id == "MAIN"
};

// Listing work orders: the site filter must be present and set to MAIN.
permit (
  principal,
  action == AOB::Action::"list_workorders",
  resource
)
when {
  context.input has site_id &&
  context.input.site_id has typeChoice0 &&
  context.input.site_id.typeChoice0 == "MAIN"
};

// Open work orders assigned to a technician: MAIN only, open work orders only.
// open_only defaults to true in the tool when omitted.
permit (
  principal,
  action == AOB::Action::"get_my_assigned_workorders",
  resource
)
when {
  context.input has site_id &&
  context.input.site_id has typeChoice0 &&
  context.input.site_id.typeChoice0 == "MAIN" &&
  (!(context.input has open_only) || context.input.open_only == true)
};

// Equipment lookups and sensor data reads (asset_ids, assets, asset_detail, installed_sensors,
// history, latest_reading, sensor_coverage, sensor_stats): MAIN only.
permit (
  principal,
  action in [
    AOB::Action::"asset_ids",
    AOB::Action::"assets",
    AOB::Action::"asset_detail",
    AOB::Action::"installed_sensors",
    AOB::Action::"history",
    AOB::Action::"latest_reading",
    AOB::Action::"sensor_coverage",
    AOB::Action::"sensor_stats"
  ],
  resource
)
when {
  context.input.site_name == "MAIN"
};
