            "properties": {
              "error": {
                "title": "Error",
                "type": "string"
              }
            },
            "required": [
              "error"
            ],
            "title": "ErrorResult",
            "type": "object"
          }
        },
        "properties": {
          "result": {
            "anyOf": [
              {
                "$ref": "#/$defs/AssetDetail"
              },
              {
                "$ref": "#/$defs/ErrorResult"
              }
            ],
            "title": "Result"
          }
        },
        "required": [
          "result"
        ],
        "title": "asset_detailOutput",
        "type": "object"
      },
      "title": "Get Asset Detail"
    },
