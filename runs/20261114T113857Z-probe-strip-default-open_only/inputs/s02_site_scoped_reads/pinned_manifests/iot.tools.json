              }
            },
            "required": [
              "error"
            ],
            "title": "ErrorResult",
            "type": "object"
          },
          "SensorsResult": {
            "properties": {
              "asset_id": {
                "title": "Asset Id",
                "type": "string"
              },
              "message": {
                "title": "Message",
                "type": "string"
              },
              "sensors": {
                "items": {
                  "type": "string"
                },
                "title": "Sensors",
                "type": "array"
              },
              "site_name": {
                "title": "Site Name",
                "type": "string"
              },
              "total_sensors": {
                "title": "Total Sensors",
                "type": "integer"
              }
            },
            "required": [
              "site_name",
              "asset_id",
              "total_sensors",
              "sensors",
              "message"
            ],
            "title": "SensorsResult",
            "type": "object"
          }
        },
        "properties": {
          "result": {
            "anyOf": [
              {
                "$ref": "#/$defs/SensorsResult"
              },
              {
                "$ref": "#/$defs/ErrorResult"
              }
            ],
            "title": "Result"
          }
        },
        "required": [
          "result"
        ],
        "title": "installed_sensorsOutput",
        "type": "object"
