{
  "tools": [
    {
      "description": "List sorted site identifiers available in the asset registry.\n\n    Returns:\n        SitesResult: Distinct site identifiers, or `[\"MAIN\"]` when the registry\n        lists none.\n    ",
      "inputSchema": {
        "properties": {},
        "title": "sitesArguments",
        "type": "object"
      },
      "name": "sites",
      "outputSchema": {
        "$defs": {
          "ErrorResult": {
            "properties": {
              "error": {
                "title": "Error",
                "type": "string"
              }
            },
            "required": [
              "error"
            ],
            "title": "ErrorResult",
            "type": "object"
          },
          "SitesResult": {
            "properties": {
              "sites": {
                "items": {
                  "type": "string"
                },
                "title": "Sites",
                "type": "array"
              }
            },
            "required": [
              "sites"
            ],
            "title": "SitesResult",
            "type": "object"
          }
        },
        "properties": {
          "result": {
            "anyOf": [
              {
                "$ref": "#/$defs/SitesResult"
              },
              {
                "$ref": "#/$defs/ErrorResult"
              }
            ],
            "title": "Result"
          }
        },
        "required": [
          "result"
        ],
        "title": "sitesOutput",
        "type": "object"
      },
      "title": "List Sites"
    },
    {
