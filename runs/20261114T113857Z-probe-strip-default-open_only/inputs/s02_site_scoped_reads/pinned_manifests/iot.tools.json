                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Sensors"
          },
          "site_name": {
            "title": "Site Name",
            "type": "string"
          },
          "start": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Start"
          }
        },
        "required": [
          "site_name",
          "asset_id"
        ],
        "title": "historyArguments",
        "type": "object"
      },
