            "title": "AssetsResult",
            "type": "object"
          },
          "ErrorResult": {
            "properties": {
              "error": {
                "title": "Error",
                "type": "string"
              }
            },
            "required": [
              "error"
            ],
            "title": "ErrorResult",
            "type": "object"
          }
        },
        "properties": {
          "result": {
            "anyOf": [
              {
                "$ref": "#/$defs/AssetsResult"
              },
              {
                "$ref": "#/$defs/ErrorResult"
              }
            ],
            "title": "Result"
          }
        },
        "required": [
          "result"
        ],
        "title": "asset_idsOutput",
        "type": "object"
      },
      "title": "List Asset IDs"
    },
