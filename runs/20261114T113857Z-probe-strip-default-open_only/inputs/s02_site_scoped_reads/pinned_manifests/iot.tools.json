            "title": "Result"
          }
        },
        "required": [
          "result"
        ],
        "title": "assetsOutput",
        "type": "object"
      },
      "title": "List Assets"
    },
    {
      "description": "Find site assets by installed or measured sensor names.\n\n    Searches only assets registered at `site_name`. Duplicate queries are\n    removed while preserving first occurrence order.\n\n    Args:\n        site_name: Exact site id to query, such as `MAIN`. Use `sites()` to\n            discover valid site ids.\n        sensors: Sensor names, or fragments when `substring` is true.\n        match: `all` requires every query; `any` requires at least one.\n        substring: Use case-insensitive fragment matching instead of exact,\n            case-sensitive matching.\n        source: `measured` searches observed fields; `installed` searches\n            registry assignments. Defaults to `measured`.\n\n    Returns:\n        FindAssetsResult: Query settings and matching assets with the concrete\n        sensor names found.\n    ",
      "inputSchema": {
        "properties": {
          "match": {
            "default": "all",
            "title": "Match",
            "type": "string"
          },
          "sensors": {
            "items": {
              "type": "string"
            },
            "title": "Sensors",
            "type": "array"
          },
          "site_name": {
            "title": "Site Name",
            "type": "string"
          },
          "source": {
            "default": "measured",
            "title": "Source",
            "type": "string"
          },
          "substring": {
            "default": false,
            "title": "Substring",
            "type": "boolean"
          }
        },
        "required": [
          "site_name",
          "sensors"
        ],
        "title": "find_assets_by_sensorsArguments",
        "type": "object"
      },
      "name": "find_assets_by_sensors",
      "outputSchema": {
        "$defs": {
          "AssetSensorMatch": {
            "properties": {
              "asset_id": {
                "title": "Asset Id",
                "type": "string"
              },
              "matched_sensors": {
                "items": {
                  "type": "string"
                },
                "title": "Matched Sensors",
                "type": "array"
              }
            },
            "required": [
              "asset_id",
              "matched_sensors"
            ],
            "title": "AssetSensorMatch",
            "type": "object"
          },
          "ErrorResult": {
            "properties": {
              "error": {
                "title": "Error",
                "type": "string"
              }
            },
            "required": [
              "error"
            ],
            "title": "ErrorResult",
            "type": "object"
          },
          "FindAssetsResult": {
            "properties": {
              "assets": {
                "items": {
                  "$ref": "#/$defs/AssetSensorMatch"
                },
                "title": "Assets",
                "type": "array"
              },
              "match": {
                "title": "Match",
                "type": "string"
              },
              "message": {
                "title": "Message",
                "type": "string"
              },
              "query_sensors": {
                "items": {
                  "type": "string"
                },
                "title": "Query Sensors",
                "type": "array"
              },
              "site_name": {
                "title": "Site Name",
                "type": "string"
              },
              "source": {
                "title": "Source",
                "type": "string"
              },
              "total_assets": {
                "title": "Total Assets",
                "type": "integer"
              }
            },
            "required": [
              "site_name",
              "query_sensors",
              "match",
              "source",
              "total_assets",
              "assets",
              "message"
            ],
            "title": "FindAssetsResult",
            "type": "object"
          }
        },
        "properties": {
          "result": {
            "anyOf": [
              {
                "$ref": "#/$defs/FindAssetsResult"
              },
              {
                "$ref": "#/$defs/ErrorResult"
              }
            ],
            "title": "Result"
          }
        },
        "required": [
          "result"
        ],
        "title": "find_assets_by_sensorsOutput",
        "type": "object"
      },
      "title": "Find Assets By Sensors"
    },
    {
      "description": "Inspect the size and timestamp span of an asset's telemetry stream.\n\n    Optionally filter by one measured sensor and a half-open ISO 8601 window:\n    `start` is inclusive and `end` is exclusive. Sensor-filtered records count\n    only when the field is present and non-null. Bounds and record timestamps\n    must consistently include or omit timezone offsets; aware timestamps are\n    compared by instant even when their offsets differ.\n\n    Args:\n        site_name: Exact site id to query, such as `MAIN`. Use `sites()` to\n            discover valid site ids.\n        asset_id: Exact asset id from `asset_ids()`, such as `Chiller 6`.\n        sensor: Optional exact field name from `measured_sensors()`.\n            Reserved metadata fields such as `asset_id` and `timestamp` are not\n            valid sensor names.\n        start: Optional inclusive ISO 8601 date or datetime lower bound.\n        end: Optional exclusive ISO 8601 date or datetime upper bound.\n\n    Returns:\n        StreamExtentResult: Earliest and latest matching timestamps, record\n        count, whether the count exceeds one 1000-record page, and average\n        interval implied by the span and count.\n    ",
      "inputSchema": {
        "properties": {
          "asset_id": {
            "title": "Asset Id",
            "type": "string"
          },
          "end": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "End"
          },
          "sensor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Sensor"
          },
          "site_name": {
            "title": "Site Name",
            "type": "string"
          },
          "start": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Start"
          }
        },
        "required": [
          "site_name",
          "asset_id"
        ],
        "title": "stream_extentArguments",
        "type": "object"
      },
      "name": "stream_extent",
      "outputSchema": {
        "$defs": {
          "ErrorResult": {
            "properties": {
              "error": {
                "title": "Error",
                "type": "string"
              }
            },
            "required": [
              "error"
            ],
            "title": "ErrorResult",
            "type": "object"
          },
          "StreamExtentResult": {
            "properties": {
              "approx_interval_seconds": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Approx Interval Seconds"
              },
              "asset_id": {
                "title": "Asset Id",
                "type": "string"
              },
              "end_time": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "End Time"
              },
              "exceeds_page_limit": {
                "title": "Exceeds Page Limit",
                "type": "boolean"
              },
              "message": {
                "title": "Message",
                "type": "string"
              },
              "sensor": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Sensor"
              },
              "site_name": {
                "title": "Site Name",
                "type": "string"
              },
              "start_time": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Start Time"
              },
              "total_records": {
                "title": "Total Records",
                "type": "integer"
              }
            },
            "required": [
              "site_name",
              "asset_id",
              "sensor",
              "start_time",
              "end_time",
              "total_records",
              "exceeds_page_limit",
              "approx_interval_seconds",
              "message"
            ],
            "title": "StreamExtentResult",
            "type": "object"
          }
        },
        "properties": {
          "result": {
            "anyOf": [
              {
                "$ref": "#/$defs/StreamExtentResult"
              },
              {
                "$ref": "#/$defs/ErrorResult"
              }
            ],
            "title": "Result"
          }
        },
        "required": [
          "result"
        ],
        "title": "stream_extentOutput",
        "type": "object"
      },
      "title": "Stream Extent"
    },
    {
      "description": "Return one chronological page of telemetry observations for an asset.\n\n    Optional bounds form a half-open ISO 8601 window. Use `sensors` to project\n    exact measured fields; omit it to return all measured fields present in each\n    row. Every row includes `asset_id` and `timestamp` and excludes other record\n    metadata.\n\n    Leave `cursor` unset for the first page. When `has_more` is true, repeat the\n    same query with `next_cursor`. Cursors are opaque and query-bound. Timestamp\n    offset rules match `stream_extent()`.\n\n    Args:\n        site_name: Exact site id to query, such as `MAIN`. Use `sites()` to\n            discover valid site ids.\n        asset_id: Exact asset id from `asset_ids()`, such as `Chiller 6`.\n        start: Optional inclusive ISO 8601 lower bound.\n        end: Optional exclusive ISO 8601 upper bound.\n        sensors: Optional non-empty list of exact measured field names. Duplicate\n            names are removed while preserving order.\n        limit: Maximum observations in this page, from 1 to 1000.\n        cursor: Opaque `next_cursor` from the previous page of the same query.\n\n    Returns:\n        HistoryResult: Projected observations, returned count, echoed bounds,\n        and cursor fields for the next page.\n    ",
      "inputSchema": {
        "properties": {
          "asset_id": {
            "title": "Asset Id",
            "type": "string"
          },
          "cursor": {
            "anyOf": [
              {
                "type": "string"
