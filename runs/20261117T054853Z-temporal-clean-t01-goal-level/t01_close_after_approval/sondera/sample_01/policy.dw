// Closing is allowed only at MAIN, and only if a lookup of the approval authority in this session,
// within the last hour, completed (::response) and confirmed that this same work order at this
// same site was approved by a human. Refused or pending decisions, failed or denied lookups
// (::error), and agent approvers never match.
// Assumption: the authority returns decision "approved" and approver_kind "human" (lowercase).
// Adjust the literals if the authority uses different values.
@id("close-workorder-main-with-human-approval")
permit (principal, action == Drupe::Action::"close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"authority_get_approval"::response{
    eventResource: resource,
    eventPrincipal: principal,
    input.wonum: context.input.wonum,
    input.site_id: context.input.site_id,
    output.decision: "approved",
    output.approver_kind: "human"
  }
};

// The approval lookup must itself be permitted, or it is never recorded as a response.
@id("allow-authority-approval-lookup")
permit (principal, action == Drupe::Action::"authority_get_approval", resource);

// Read-only lookups the agent may use.
@id("allow-readonly-lookups")
permit (principal, action in [
  Drupe::Action::"get_workorder",
  Drupe::Action::"list_workorders",
  Drupe::Action::"get_workorder_tasks",
  Drupe::Action::"get_workorder_costs",
  Drupe::Action::"get_workorder_actuals_vs_planned",
  Drupe::Action::"get_workorder_kpis",
  Drupe::Action::"get_schedule_calendar",
  Drupe::Action::"get_my_assigned_workorders",
  Drupe::Action::"get_failure_codes"
], resource);

// approve_workorder, generate_work_order, update_workorder, assign_technician and
// cancel_workorder have no permit, so they are denied by default.
