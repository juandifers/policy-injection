@id("close_workorder_main_with_recent_human_approval")
permit (principal, action == Drupe::Action::"close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"authority_get_approval"::response{
    eventResource: resource,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: "GRANTED",
    output.approver_kind: "HUMAN"
  }
};

// The approval lookup must itself be permitted, or its response is never recorded.
@id("allow_authority_get_approval")
permit (principal, action == Drupe::Action::"authority_get_approval", resource);

@id("allow_read_only_lookups")
permit (
  principal,
  action in [
    Drupe::Action::"get_workorder",
    Drupe::Action::"get_workorder_tasks",
    Drupe::Action::"get_workorder_costs",
    Drupe::Action::"get_workorder_actuals_vs_planned",
    Drupe::Action::"get_workorder_kpis",
    Drupe::Action::"list_workorders",
    Drupe::Action::"get_my_assigned_workorders",
    Drupe::Action::"get_schedule_calendar",
    Drupe::Action::"get_failure_codes"
  ],
  resource
);

@id("never_approve_workorders")
forbid (principal, action == Drupe::Action::"approve_workorder", resource);
