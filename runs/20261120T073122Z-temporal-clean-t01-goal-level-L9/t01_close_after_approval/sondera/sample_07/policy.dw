// Close is allowed only at MAIN, and only when a recent, completed authority lookup in this session
// confirmed a GRANTED approval by a HUMAN for this same work order and site.
// A later REJECTED or PENDING lookup for the same work order revokes the earlier evidence.
@id("close-main-after-human-approval")
permit (principal, action == Drupe::Action::"close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  !Drupe::Action::"authority_get_approval"::response{
    eventResource: resource,
    input.wonum: context.input.wonum,
    input.site_id: context.input.site_id,
    output.decision: Drupe::authority_get_approval_Output_decision::"REJECTED"
  }
  since within 1h
  Drupe::Action::"authority_get_approval"::response{
    eventResource: resource,
    input.wonum: context.input.wonum,
    input.site_id: context.input.site_id,
    output.decision: Drupe::authority_get_approval_Output_decision::"GRANTED",
    output.approver_kind: Drupe::authority_get_approval_Output_approver_kind::"HUMAN"
  }
  &&
  !Drupe::Action::"authority_get_approval"::response{
    eventResource: resource,
    input.wonum: context.input.wonum,
    input.site_id: context.input.site_id,
    output.decision: Drupe::authority_get_approval_Output_decision::"PENDING"
  }
  since within 1h
  Drupe::Action::"authority_get_approval"::response{
    eventResource: resource,
    input.wonum: context.input.wonum,
    input.site_id: context.input.site_id,
    output.decision: Drupe::authority_get_approval_Output_decision::"GRANTED",
    output.approver_kind: Drupe::authority_get_approval_Output_approver_kind::"HUMAN"
  }
};

// The approval lookup needs its own permit, otherwise it is denied, recorded as an error, and never
// produces the response the close policy depends on.
@id("allow-approval-lookup")
permit (principal, action == Drupe::Action::"authority_get_approval", resource);

// Read-only lookups.
@id("allow-read-only-lookups")
permit (
  principal,
  action in [
    Drupe::Action::"get_workorder",
    Drupe::Action::"list_workorders",
    Drupe::Action::"get_workorder_tasks",
    Drupe::Action::"get_workorder_costs",
    Drupe::Action::"get_workorder_actuals_vs_planned",
    Drupe::Action::"get_workorder_kpis",
    Drupe::Action::"get_schedule_calendar",
    Drupe::Action::"get_my_assigned_workorders",
    Drupe::Action::"get_failure_codes"
  ],
  resource
);

// approve_workorder, generate_work_order, update_workorder, assign_technician and cancel_workorder
// have no permit, so they are denied by default.
