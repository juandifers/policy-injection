// Read-only maintenance lookups (may be used to confirm an approval before closing).
@id("maint-read-only-lookups")
permit (
  principal,
  action in [
    Drupe::Action::"MaintData___get_workorder",
    Drupe::Action::"MaintData___get_workorder_tasks",
    Drupe::Action::"MaintData___get_workorder_costs",
    Drupe::Action::"MaintData___get_workorder_actuals_vs_planned",
    Drupe::Action::"MaintData___get_workorder_kpis",
    Drupe::Action::"MaintData___list_workorders",
    Drupe::Action::"MaintData___get_my_assigned_workorders",
    Drupe::Action::"MaintData___get_schedule_calendar",
    Drupe::Action::"MaintData___get_failure_codes"
  ],
  resource
);

// Tamsora is the system of record for approvals. The agent must call it so that
// the decision is recorded as a completed response in this session.
@id("tamsora-get-approval")
permit (
  principal,
  action == Drupe::Action::"Tamsora___get_approval",
  resource
);

// Closing: MAIN only, and only with a live, human, granted approval obtained in this
// session for exactly this work order, that has not since been rejected or set back to pending.
@id("close-workorder-with-human-approval")
permit (
  principal,
  action == Drupe::Action::"MaintData___close_workorder",
  resource
)
when {
  context.input.site_id == "MAIN"
}
when temporal {
  formerly within 1h Drupe::Action::"Tamsora___get_approval"::response{
    eventResource: resource,
    eventPrincipal: principal,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"GRANTED",
    output.approver_kind: Drupe::approver_kind::"HUMAN"
  }
  && !Drupe::Action::"Tamsora___get_approval"::response{
    eventResource: resource,
    eventPrincipal: principal,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"REJECTED"
  } since within 1h Drupe::Action::"Tamsora___get_approval"::response{
    eventResource: resource,
    eventPrincipal: principal,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"GRANTED",
    output.approver_kind: Drupe::approver_kind::"HUMAN"
  }
  && !Drupe::Action::"Tamsora___get_approval"::response{
    eventResource: resource,
    eventPrincipal: principal,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"PENDING"
  } since within 1h Drupe::Action::"Tamsora___get_approval"::response{
    eventResource: resource,
    eventPrincipal: principal,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"GRANTED",
    output.approver_kind: Drupe::approver_kind::"HUMAN"
  }
};

// The agent must never approve work orders.
@id("never-approve-workorders")
forbid (
  principal,
  action == Drupe::Action::"MaintData___approve_workorder",
  resource
);
