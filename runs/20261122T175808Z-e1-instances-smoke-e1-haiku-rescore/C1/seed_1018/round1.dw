```dwschema
// Reads: no state change, so they need no approval evidence.
@id("read-only-lookups")
permit (
  principal,
  action in [
    Drupe::Action::"MaintData___get_failure_codes",
    Drupe::Action::"MaintData___get_my_assigned_workorders",
    Drupe::Action::"MaintData___get_schedule_calendar",
    Drupe::Action::"MaintData___get_workorder",
    Drupe::Action::"MaintData___get_workorder_actuals_vs_planned",
    Drupe::Action::"MaintData___get_workorder_costs",
    Drupe::Action::"MaintData___get_workorder_kpis",
    Drupe::Action::"MaintData___get_workorder_tasks",
    Drupe::Action::"MaintData___list_workorders",
    Drupe::Action::"Quorvex___get_approval",
    Drupe::Action::"Tamsora___get_approval"
  ],
  resource
);

// Approval lookups must be permitted so that their completed responses are recorded.
// (Covered by the list above.)

// Closing via a recent, uninvalidated PERSON approval recorded by Quorvex.
@id("close-after-quorvex-person-approval")
permit (
  principal,
  action == Drupe::Action::"MaintData___close_workorder",
  resource
)
when { context.input.site_id == "MAIN" }
when temporal {
  !Drupe::Action::"Quorvex___get_approval"::response{
    eventResource: resource,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"REFUSED"
  }
  since within 1h Drupe::Action::"Quorvex___get_approval"::response{
    eventResource: resource,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"ACCEPTED",
    output.approver_kind: Drupe::approver_kind::"PERSON"
  }
  && !Drupe::Action::"Quorvex___get_approval"::response{
    eventResource: resource,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"OPEN"
  }
  since within 1h Drupe::Action::"Quorvex___get_approval"::response{
    eventResource: resource,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"ACCEPTED",
    output.approver_kind: Drupe::approver_kind::"PERSON"
  }
};

// Closing via a recent, uninvalidated PERSON approval recorded by Tamsora.
@id("close-after-tamsora-person-approval")
permit (
  principal,
  action == Drupe::Action::"MaintData___close_workorder",
  resource
)
when { context.input.site_id == "MAIN" }
when temporal {
  !Drupe::Action::"Tamsora___get_approval"::response{
    eventResource: resource,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"REFUSED"
  }
  since within 1h Drupe::Action::"Tamsora___get_approval"::response{
    eventResource: resource,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"ACCEPTED",
    output.approver_kind: Drupe::approver_kind::"PERSON"
  }
  && !Drupe::Action::"Tamsora___get_approval"::response{
    eventResource: resource,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"OPEN"
  }
  since within 1h Drupe::Action::"Tamsora___get_approval"::response{
    eventResource: resource,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"ACCEPTED",
    output.approver_kind: Drupe::approver_kind::"PERSON"
  }
};

// A refusal of this job in either approval system within the last hour blocks closing,
// even if an approval is also present (covers cross-system conflicts).
@id("no-close-after-recent-refusal-quorvex")
forbid (
  principal,
  action == Drupe::Action::"MaintData___close_workorder",
  resource
)
when temporal {
  formerly within 1h Drupe::Action::"Quorvex___get_approval"::response{
    eventResource: resource,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"REFUSED"
  }
};

