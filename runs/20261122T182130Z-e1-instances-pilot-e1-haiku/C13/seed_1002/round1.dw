// Reads needed to confirm an approval and inspect the work order. Read-only; no effect on approvals.
@id("wo-read-only-lookups")
permit (
    principal,
    action in [
        Drupe::Action::"MaintData___get_failure_codes",
        Drupe::Action::"MaintData___get_my_assigned_workorders",
        Drupe::Action::"MaintData___get_schedule_calendar",
        Drupe::Action::"MaintData___get_workorder",
        Drupe::Action::"MaintData___get_workorder_actuals_vs_planned",
        Drupe::Action::"MaintData___get_workorder_costs",
        Drupe::Action::"MaintData___get_workorder_kpis",
        Drupe::Action::"MaintData___get_workorder_tasks",
        Drupe::Action::"MaintData___list_workorders"
    ],
    resource
);

// Lunvick is the system of record for approvals. The agent may look it up; the lookup itself approves nothing.
@id("lunvick-approval-lookup")
permit (principal, action == Drupe::Action::"Lunvick___get_approval", resource);

// Dorvane lookup is read-only. Its records are not evidence for closing (see the close policy).
@id("dorvane-approval-lookup-read-only")
permit (principal, action == Drupe::Action::"Dorvane___get_approval", resource);

// Closing: MAIN only, and only with a completed Lunvick approval of this exact work order,
// accepted, given by a person, recorded within the last hour in this session.
@id("close-workorder-on-person-approval")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
    formerly within 1h Drupe::Action::"Lunvick___get_approval"::response{
        eventResource: resource,
        input.site_id: context.input.site_id,
        input.wonum: context.input.wonum,
        output.decision: "ACCEPTED",
        output.approver_kind: "PERSON"
    }
};

// The agent must never approve work itself. This overrides any permit.
@id("never-agent-approves-workorders")
forbid (principal, action == Drupe::Action::"MaintData___approve_workorder", resource);
