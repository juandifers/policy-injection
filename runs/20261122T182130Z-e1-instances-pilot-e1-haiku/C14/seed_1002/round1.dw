// Read-only lookups. Deny-by-default still applies to everything not listed here.
// Both approval lookups are permitted so the close policy can use their recorded responses.
@id("permit-readonly-lookups")
permit (
  principal,
  action in [
    Drupe::Action::"MaintData___get_workorder",
    Drupe::Action::"MaintData___get_workorder_tasks",
    Drupe::Action::"MaintData___get_workorder_costs",
    Drupe::Action::"MaintData___get_workorder_actuals_vs_planned",
    Drupe::Action::"MaintData___get_workorder_kpis",
    Drupe::Action::"MaintData___list_workorders",
    Drupe::Action::"MaintData___get_my_assigned_workorders",
    Drupe::Action::"MaintData___get_schedule_calendar",
    Drupe::Action::"MaintData___get_failure_codes",
    Drupe::Action::"Lunvick___get_approval",
    Drupe::Action::"Dorvane___get_approval"
  ],
  resource == Drupe::Gateway::"wo"
);

// Closing: MAIN only, and only against an approval that Lunvick recorded in this session.
// The approval counts only if the lookup response (a completed call) shows the same work order and site,
// an ACCEPTED decision, and a PERSON approver, and that response is no more than 1h old.
// Dorvane approvals are not considered. Approver kinds other than PERSON (AUTOMATION, SERVICE, or anything
// else) never match. Failed or refused calls are recorded as errors, not responses, so they never match.
// The schema has no approval timestamp, so the recency window is measured from the confirming lookup.
// Lunvick's output is a String, so the literals "ACCEPTED" and "PERSON" are assumed to match Lunvick's values.
@id("permit-close-main-on-person-approval")
permit (
  principal,
  action == Drupe::Action::"MaintData___close_workorder",
  resource == Drupe::Gateway::"wo"
)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Lunvick___get_approval"::response{
    eventResource: resource,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: "ACCEPTED",
    output.approver_kind: "PERSON"
  }
};

// The agent must never approve work orders itself. Explicit forbid, so no permit can override it.
@id("forbid-agent-approve-workorder")
forbid (
  principal,
  action == Drupe::Action::"MaintData___approve_workorder",
  resource
);
