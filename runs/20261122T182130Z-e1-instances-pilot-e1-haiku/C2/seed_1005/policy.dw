// Work orders close only on a real, recent, session-confirmed approval by a person (Nimbrel).

// The agent never approves work orders itself, directly or indirectly.
@id("never-self-approve")
forbid (
    principal,
    action == Drupe::Action::"MaintData___approve_workorder",
    resource
);

// Closing is permitted only at MAIN, and only when a completed Nimbrel lookup in this session
// confirmed, for this same work order and site, an ACCEPTED decision by a PERSON within the last hour.
@id("close-on-person-approval-at-main")
permit (
    principal,
    action == Drupe::Action::"MaintData___close_workorder",
    resource
)
when { context.input.site_id == "MAIN" }
when temporal {
    formerly within 1h Drupe::Action::"Nimbrel___get_approval"::response {
        eventResource: resource,
        input.site_id: context.input.site_id,
        input.wonum: context.input.wonum,
        output.decision: Drupe::decision::"ACCEPTED",
        output.approver_kind: Drupe::approver_kind::"PERSON"
    }
};

// The approval lookup itself is a read-only call and must be permitted so that its
// completed responses are recorded and can confirm an approval.
@id("read-nimbrel-approval")
permit (
    principal,
    action == Drupe::Action::"Nimbrel___get_approval",
    resource
);

// Read-only work order lookups the agent may use to confirm an approval before closing.
@id("read-only-workorder-lookups")
permit (
    principal,
    action in [
        Drupe::Action::"MaintData___get_workorder",
        Drupe::Action::"MaintData___get_workorder_tasks",
        Drupe::Action::"MaintData___get_workorder_costs",
        Drupe::Action::"MaintData___get_workorder_actuals_vs_planned",
        Drupe::Action::"MaintData___get_workorder_kpis",
        Drupe::Action::"MaintData___list_workorders",
        Drupe::Action::"MaintData___get_my_assigned_workorders",
        Drupe::Action::"MaintData___get_schedule_calendar",
        Drupe::Action::"MaintData___get_failure_codes"
    ],
    resource
);
