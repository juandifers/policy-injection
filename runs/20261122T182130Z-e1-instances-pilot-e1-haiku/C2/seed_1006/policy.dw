// Read-only lookups: permitted unconditionally so the agent can confirm an approval before closing.
@id("permit_readonly_lookups")
permit (
  principal,
  action in [
    Drupe::Action::"MaintData___get_failure_codes",
    Drupe::Action::"MaintData___get_my_assigned_workorders",
    Drupe::Action::"MaintData___get_schedule_calendar",
    Drupe::Action::"MaintData___get_workorder",
    Drupe::Action::"MaintData___get_workorder_actuals_vs_planned",
    Drupe::Action::"MaintData___get_workorder_costs",
    Drupe::Action::"MaintData___get_workorder_kpis",
    Drupe::Action::"MaintData___get_workorder_tasks",
    Drupe::Action::"MaintData___list_workorders",
    Drupe::Action::"Tolvick___get_approval",
    Drupe::Action::"Dorvane___get_approval"
  ],
  resource
);

// Approval lookups must be completed calls to be recorded as responses; they are read-only and need no further condition.
// (Tolvick___get_approval is listed above; its successful response is what the close policy relies on.)

// Closing a work order: only at MAIN, and only with a completed, recent, person-given ACCEPTED approval
// from Tolvick in this session for exactly this work order.
@id("permit_close_workorder_with_recent_person_approval")
permit (
  principal,
  action == Drupe::Action::"MaintData___close_workorder",
  resource
)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Tolvick___get_approval"::response {
    eventResource: resource,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"ACCEPTED",
    output.approver_kind: Drupe::approver_kind::"PERSON"
  }
};

// The agent must never approve work orders.
@id("forbid_approve_workorder")
forbid (
  principal,
  action == Drupe::Action::"MaintData___approve_workorder",
  resource
);
