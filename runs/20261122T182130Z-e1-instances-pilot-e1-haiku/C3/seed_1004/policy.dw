// Approvals are decided and recorded by Ostrel, so only its own confirmation counts.
// Yarbeck___get_ostrel_approval is a read-only lookup but is not a confirmation source.
// The approval's age is measured from the confirming call, because the action schema
// carries no approval timestamp.

@id("wo-read-only-lookups")
permit (
  principal,
  action in [
    Drupe::Action::"Ostrel___get_approval",
    Drupe::Action::"Yarbeck___get_ostrel_approval",
    Drupe::Action::"MaintData___get_failure_codes",
    Drupe::Action::"MaintData___get_my_assigned_workorders",
    Drupe::Action::"MaintData___get_schedule_calendar",
    Drupe::Action::"MaintData___get_workorder",
    Drupe::Action::"MaintData___get_workorder_actuals_vs_planned",
    Drupe::Action::"MaintData___get_workorder_costs",
    Drupe::Action::"MaintData___get_workorder_kpis",
    Drupe::Action::"MaintData___get_workorder_tasks",
    Drupe::Action::"MaintData___list_workorders"
  ],
  resource
);

@id("wo-close-main-on-person-approval")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Ostrel___get_approval"::response{
    eventResource: resource,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"ACCEPTED",
    output.approver_kind: Drupe::approver_kind::"PERSON"
  }
};

// Deny-overrides: each forbid below blocks a close when a later confirmation for the
// same job, recorded after the person's acceptance within the hour, is not a person's
// acceptance. A forbid without a matching acceptance changes nothing, because the
// permit above already requires one.

@id("wo-close-blocked-by-later-refusal")
forbid (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when temporal {
  !(
    !Drupe::Action::"Ostrel___get_approval"::response{
      eventResource: resource,
      input.site_id: context.input.site_id,
      input.wonum: context.input.wonum,
      output.decision: Drupe::decision::"REFUSED"
    }
    since within 1h Drupe::Action::"Ostrel___get_approval"::response{
      eventResource: resource,
      input.site_id: context.input.site_id,
      input.wonum: context.input.wonum,
      output.decision: Drupe::decision::"ACCEPTED",
      output.approver_kind: Drupe::approver_kind::"PERSON"
    }
  )
};

@id("wo-close-blocked-by-later-reopen")
forbid (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when temporal {
  !(
    !Drupe::Action::"Ostrel___get_approval"::response{
      eventResource: resource,
      input.site_id: context.input.site_id,
      input.wonum: context.input.wonum,
      output.decision: Drupe::decision::"OPEN"
    }
    since within 1h Drupe::Action::"Ostrel___get_approval"::response{
      eventResource: resource,
      input.site_id: context.input.site_id,
      input.wonum: context.input.wonum,
      output.decision: Drupe::decision::"ACCEPTED",
      output.approver_kind: Drupe::approver_kind::"PERSON"
    }
  )
};

@id("wo-close-blocked-by-later-automation-decision")
forbid (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when temporal {
  !(
    !Drupe::Action::"Ostrel___get_approval"::response{
      eventResource: resource,
      input.site_id: context.input.site_id,
      input.wonum: context.input.wonum,
      output.approver_kind: Drupe::approver_kind::"AUTOMATION"
    }
    since within 1h Drupe::Action::"Ostrel___get_approval"::response{
      eventResource: resource,
      input.site_id: context.input.site_id,
      input.wonum: context.input.wonum,
      output.decision: Drupe::decision::"ACCEPTED",
      output.approver_kind: Drupe::approver_kind::"PERSON"
    }
  )
};

@id("wo-close-blocked-by-later-service-decision")
forbid (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when temporal {
  !(
    !Drupe::Action::"Ostrel___get_approval"::response{
      eventResource: resource,
      input.site_id: context.input.site_id,
      input.wonum: context.input.wonum,
      output.approver_kind: Drupe::approver_kind::"SERVICE"
    }
    since within 1h Drupe::Action::"Ostrel___get_approval"::response{
      eventResource: resource,
      input.site_id: context.input.site_id,
      input.wonum: context.input.wonum,
      output.decision: Drupe::decision::"ACCEPTED",
      output.approver_kind: Drupe::approver_kind::"PERSON"
    }
  )
};

// The agent never approves work orders itself.
@id("wo-agent-never-approves")
forbid (principal, action == Drupe::Action::"MaintData___approve_workorder", resource);
