// Read-only lookups. Only Lunvick's get_approval can supply approval evidence. Dorvane is not listed.
@id("lunvick_approval_lookup")
permit (principal, action == Drupe::Action::"Lunvick___get_approval", resource);

@id("maint_read_only_lookups")
permit (
  principal,
  action in [
    Drupe::Action::"MaintData___get_workorder",
    Drupe::Action::"MaintData___get_workorder_tasks",
    Drupe::Action::"MaintData___get_workorder_costs",
    Drupe::Action::"MaintData___get_workorder_actuals_vs_planned",
    Drupe::Action::"MaintData___get_workorder_kpis",
    Drupe::Action::"MaintData___get_failure_codes",
    Drupe::Action::"MaintData___list_workorders",
    Drupe::Action::"MaintData___get_my_assigned_workorders",
    Drupe::Action::"MaintData___get_schedule_calendar"
  ],
  resource
);

// Closing: MAIN only, and only against a Lunvick approval that a PERSON accepted for this
// work order (site and wonum), fetched by this principal in this session, within the last hour,
// and not superseded by a later REFUSED or OPEN answer for the same work order.
@id("close_workorder_main_on_recent_person_approval")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Lunvick___get_approval"::response{
    eventResource: resource,
    eventPrincipal: principal,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"ACCEPTED",
    output.approver_kind: Drupe::approver_kind::"PERSON"
  }
  && !Drupe::Action::"Lunvick___get_approval"::response{
    eventResource: resource,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"REFUSED"
  } since within 1h Drupe::Action::"Lunvick___get_approval"::response{
    eventResource: resource,
    eventPrincipal: principal,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"ACCEPTED",
    output.approver_kind: Drupe::approver_kind::"PERSON"
  }
  && !Drupe::Action::"Lunvick___get_approval"::response{
    eventResource: resource,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"OPEN"
  } since within 1h Drupe::Action::"Lunvick___get_approval"::response{
    eventResource: resource,
    eventPrincipal: principal,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"ACCEPTED",
    output.approver_kind: Drupe::approver_kind::"PERSON"
  }
};

// The agent never approves work orders, and generic pass-through actions are blocked.
@id("never_agent_approves")
forbid (principal, action == Drupe::Action::"MaintData___approve_workorder", resource);

@id("no_generic_call_tool")
forbid (principal, action == Drupe::Action::"CallTool", resource);

@id("no_generic_mcp")
forbid (principal, action == Drupe::Action::"Mcp", resource);
