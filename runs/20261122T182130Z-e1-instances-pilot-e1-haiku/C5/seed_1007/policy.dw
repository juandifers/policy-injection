// Read-only lookups. Kelvora___get_approval must be permitted so that its completed calls are recorded as responses.
// Vantry___get_kelvora_approval is deliberately not permitted: another system's record is not evidence.
permit (
  principal,
  action in [
    Drupe::Action::"MaintData___get_workorder",
    Drupe::Action::"MaintData___get_workorder_tasks",
    Drupe::Action::"MaintData___get_workorder_costs",
    Drupe::Action::"MaintData___get_workorder_actuals_vs_planned",
    Drupe::Action::"MaintData___get_workorder_kpis",
    Drupe::Action::"MaintData___get_schedule_calendar",
    Drupe::Action::"MaintData___get_my_assigned_workorders",
    Drupe::Action::"MaintData___list_workorders",
    Drupe::Action::"MaintData___get_failure_codes"
  ],
  resource
);

@id("kelvora-approval-lookup")
permit (principal, action == Drupe::Action::"Kelvora___get_approval", resource);

// The agent never approves work orders itself. This forbid overrides any permit.
@id("agent-never-approves")
forbid (principal, action == Drupe::Action::"MaintData___approve_workorder", resource);

// Closing is permitted only at MAIN, and only when a person (Kelvora HUMAN approver) granted approval
// for this same work order, confirmed by a completed Kelvora lookup in this session within the last hour.
// The recorded approval time is not in the schema, so recency is bounded by the confirming lookup's time.
// The agent's own approval response for this work order must not exist in the session.
@id("close-workorder-on-human-approval")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Kelvora___get_approval"::response{
    eventPrincipal: principal,
    eventResource: resource,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"GRANTED",
    output.approver_kind: Drupe::approver_kind::"HUMAN"
  }
  && !formerly within 24h Drupe::Action::"MaintData___approve_workorder"::response{
    eventResource: resource,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum
  }
};
