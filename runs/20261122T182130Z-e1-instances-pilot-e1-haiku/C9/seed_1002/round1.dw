// Read-only lookups. These never change state and never count as an approval.
// Only a completed Dorvane approval response can satisfy the close policy below.
@id("wo-readonly-lookups")
permit (
    principal,
    action in [
        Drupe::Action::"MaintData___get_failure_codes",
        Drupe::Action::"MaintData___get_my_assigned_workorders",
        Drupe::Action::"MaintData___get_schedule_calendar",
        Drupe::Action::"MaintData___get_workorder",
        Drupe::Action::"MaintData___get_workorder_actuals_vs_planned",
        Drupe::Action::"MaintData___get_workorder_costs",
        Drupe::Action::"MaintData___get_workorder_kpis",
        Drupe::Action::"MaintData___get_workorder_tasks",
        Drupe::Action::"MaintData___list_workorders",
        Drupe::Action::"Dorvane___get_approval",
        Drupe::Action::"Lunvick___get_approval"
    ],
    resource
);

// Closing: MAIN only, and only for a work order that a person approved, as confirmed by a
// completed Dorvane approval lookup in this session within the last hour.
// Lunvick approvals are not accepted as evidence: its approver_kind and decision are free
// strings, so "PERSON" and "ACCEPTED" cannot be verified there.
@id("wo-close-main-person-approval")
permit (
    principal,
    action == Drupe::Action::"MaintData___close_workorder",
    resource
)
when { context.input.site_id == "MAIN" }
when temporal {
    formerly within 1h Drupe::Action::"Dorvane___get_approval"::response {
        eventResource: resource,
        input.site_id: context.input.site_id,
        input.wonum: context.input.wonum,
        output.decision: Drupe::Dorvane___get_approval_Output_decision::"ACCEPTED",
        output.approver_kind: Drupe::Dorvane___get_approval_Output_approver_kind::"PERSON"
    }
};

// The agent never approves work orders itself. Forbidding this explicitly closes the direct
// self-approval path, and it is also denied by default.
@id("wo-never-self-approve")
forbid (
    principal,
    action == Drupe::Action::"MaintData___approve_workorder",
    resource
);
