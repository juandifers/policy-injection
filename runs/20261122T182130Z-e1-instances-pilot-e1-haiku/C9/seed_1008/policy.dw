// Read-only lookups. Permitted so the agent can confirm an approval before closing.
// Nimbrel and Quorvex approval lookups are read-only and do not themselves establish approval.
@id("wo-readonly-lookups")
permit (
  principal,
  action in [
    Drupe::Action::"MaintData___get_workorder",
    Drupe::Action::"MaintData___get_workorder_tasks",
    Drupe::Action::"MaintData___get_workorder_costs",
    Drupe::Action::"MaintData___get_workorder_actuals_vs_planned",
    Drupe::Action::"MaintData___get_workorder_kpis",
    Drupe::Action::"MaintData___get_failure_codes",
    Drupe::Action::"MaintData___get_my_assigned_workorders",
    Drupe::Action::"MaintData___get_schedule_calendar",
    Drupe::Action::"MaintData___list_workorders",
    Drupe::Action::"Nimbrel___get_approval",
    Drupe::Action::"Quorvex___get_approval"
  ],
  resource
);

// The agent must never approve work orders, and no permit can override this.
@id("wo-never-approve")
forbid (
  principal,
  action == Drupe::Action::"MaintData___approve_workorder",
  resource
);

// Close a work order only at MAIN, and only when this session has a completed
// (response, not error) Nimbrel approval lookup, within the last hour, that:
//  - was made by this principal,
//  - concerns exactly this site_id and wonum,
//  - shows a HUMAN approver with decision GRANTED.
// Quorvex is excluded because its approver_kind and decision are untyped strings.
// Nimbrel's enums (HUMAN / AGENT / SYSTEM, GRANTED / REJECTED / PENDING) are used instead.
@id("wo-close-main-with-recent-human-approval")
permit (
  principal,
  action == Drupe::Action::"MaintData___close_workorder",
  resource
)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Nimbrel___get_approval"::response{
    eventResource: resource,
    eventPrincipal: principal,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.approver_kind: Drupe::Nimbrel___get_approval_Output_approver_kind::"HUMAN",
    output.decision: Drupe::Nimbrel___get_approval_Output_decision::"GRANTED"
  }
};
