// Read-only approval lookups must be permitted so their responses are recorded.
@id("allow_kelvora_get_approval")
permit (principal, action == Drupe::Action::"Kelvora___get_approval", resource);

@id("allow_tolvick_get_approval")
permit (principal, action == Drupe::Action::"Tolvick___get_approval", resource);

// Close at MAIN only, with a human GRANTED approval for this exact work order and site,
// confirmed by a completed Kelvora lookup within the last hour of this session.
@id("close_main_with_human_approval_kelvora")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Kelvora___get_approval"::response{
    eventResource: resource,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"GRANTED",
    output.approver_kind: Drupe::approver_kind::"HUMAN"
  }
};

// Same, with approval confirmed via the Tolvick lookup.
@id("close_main_with_human_approval_tolvick")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Tolvick___get_approval"::response{
    eventResource: resource,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"GRANTED",
    output.approver_kind: Drupe::approver_kind::"HUMAN"
  }
};

// The agent may never approve work orders, regardless of any other policy.
@id("forbid_agent_approve_workorder")
forbid (principal, action == Drupe::Action::"MaintData___approve_workorder", resource);
