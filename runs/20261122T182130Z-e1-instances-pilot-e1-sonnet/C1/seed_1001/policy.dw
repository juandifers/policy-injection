// Closing a work order: MAIN site only, and only with a recent, matching,
// human, granted approval confirmed in this session by a completed lookup.
// The approval lookup exists on two targets, so there is one permit per target
// (a temporal block has no ||).

@id("close_workorder_main_with_dorvane_approval")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Dorvane___get_approval"::response{
    eventResource: resource,
    input.wonum: context.input.wonum,
    input.site_id: context.input.site_id,
    output.decision: Drupe::decision::"GRANTED",
    output.approver_kind: Drupe::approver_kind::"HUMAN"
  }
};

@id("close_workorder_main_with_quorvex_approval")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Quorvex___get_approval"::response{
    eventResource: resource,
    input.wonum: context.input.wonum,
    input.site_id: context.input.site_id,
    output.decision: Drupe::decision::"GRANTED",
    output.approver_kind: Drupe::approver_kind::"HUMAN"
  }
};

// Read-only approval lookups must themselves be permitted, otherwise they are
// recorded as errors and never produce the responses the close policies need.
@id("allow_dorvane_get_approval")
permit (principal, action == Drupe::Action::"Dorvane___get_approval", resource);

@id("allow_quorvex_get_approval")
permit (principal, action == Drupe::Action::"Quorvex___get_approval", resource);

// The agent may never approve work orders itself.
@id("forbid_agent_approve_workorder")
forbid (principal, action == Drupe::Action::"MaintData___approve_workorder", resource);

// Closing is never allowed outside MAIN.
@id("forbid_close_outside_main")
forbid (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
unless { context.input.site_id == "MAIN" };
