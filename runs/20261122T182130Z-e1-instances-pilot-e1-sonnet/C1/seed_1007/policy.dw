// Reads the agent needs in order to confirm an approval. These must be
// permitted so that their responses are recorded in the session history.
@id("allow_kelvora_get_approval")
permit (principal, action == Drupe::Action::"Kelvora___get_approval", resource);

@id("allow_vantry_get_approval")
permit (principal, action == Drupe::Action::"Vantry___get_approval", resource);

@id("allow_get_workorder")
permit (principal, action == Drupe::Action::"MaintData___get_workorder", resource);

// Close at MAIN only, with a GRANTED approval by a HUMAN approver for the same
// work order and site, confirmed by a completed Kelvora lookup in the last hour.
@id("close_workorder_main_with_kelvora_human_approval")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Kelvora___get_approval"::response{
    eventResource: resource,
    input.wonum: context.input.wonum,
    input.site_id: context.input.site_id,
    output.decision: Drupe::decision::"GRANTED",
    output.approver_kind: Drupe::approver_kind::"HUMAN"
  }
};

// Same, confirmed by a completed Vantry lookup.
@id("close_workorder_main_with_vantry_human_approval")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Vantry___get_approval"::response{
    eventResource: resource,
    input.wonum: context.input.wonum,
    input.site_id: context.input.site_id,
    output.decision: Drupe::decision::"GRANTED",
    output.approver_kind: Drupe::approver_kind::"HUMAN"
  }
};

// The agent must never approve work orders itself.
@id("never_approve_workorder")
forbid (principal, action == Drupe::Action::"MaintData___approve_workorder", resource);
