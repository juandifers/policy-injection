// Read-only lookup of the approval record in Lunvick, the system of record.
// It must be permitted so that its response is recorded and can be used as evidence.
@id("allow-lunvick-approval-lookup")
permit (principal, action == Drupe::Action::"Lunvick___get_approval", resource);

// Closing is allowed only at MAIN. It needs a completed Lunvick lookup in this session
// within the last hour. That lookup must be for the same work order and site, must show
// ACCEPTED, and must show a PERSON as the approver.
@id("allow-close-main-with-person-approval")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Lunvick___get_approval"::response{
    eventResource: resource,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"ACCEPTED",
    output.approver_kind: Drupe::approver_kind::"PERSON"
  }
};

// The agent must never approve work orders itself. No permit exists for approval,
// and this forbid makes the denial explicit.
@id("forbid-agent-approval")
forbid (principal, action == Drupe::Action::"MaintData___approve_workorder", resource);

// Closing anywhere other than MAIN is always denied.
@id("forbid-close-outside-main")
forbid (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
unless { context.input.site_id == "MAIN" };
