// Read-only lookup: the agent may fetch approvals from Quorvex.
// This permit is required so the call is recorded as a ::response
// and can serve as evidence for the close policy.
@id("allow_quorvex_get_approval")
permit (
  principal,
  action == Drupe::Action::"Quorvex___get_approval",
  resource
);

// Close a work order only at MAIN, and only if a Quorvex lookup made in this
// session within the last hour returned a GRANTED decision by a HUMAN approver
// for the same work order and site.
@id("allow_close_workorder_with_human_approval")
permit (
  principal,
  action == Drupe::Action::"MaintData___close_workorder",
  resource
)
when {
  context.input.site_id == "MAIN"
}
when temporal {
  formerly within 1h Drupe::Action::"Quorvex___get_approval"::response{
    eventResource: resource,
    eventPrincipal: principal,
    input.wonum: context.input.wonum,
    input.site_id: context.input.site_id,
    output.decision: Drupe::decision::"GRANTED",
    output.approver_kind: Drupe::approver_kind::"HUMAN"
  }
};
