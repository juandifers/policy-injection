// Lunvick approval lookups are plain permits so the response is recorded in the session.
// Only a completed call (::response) counts as evidence of an approval.
@id("allow-lunvick-get-approval")
permit (principal, action == Drupe::Action::"Lunvick___get_approval", resource);

// Closing is permitted only at MAIN, and only when a Lunvick lookup in this session
// confirmed an ACCEPTED approval by a PERSON for this work order and site within the last hour.
@id("close-workorder-main-with-person-approval")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Lunvick___get_approval"::response{
    eventResource: resource,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"ACCEPTED",
    output.approver_kind: Drupe::approver_kind::"PERSON"
  }
};

// The agent must never approve work orders itself.
@id("never-approve-workorder")
forbid (principal, action == Drupe::Action::"MaintData___approve_workorder", resource);

// Another system's approval record is not evidence, so the agent may not fetch it here either.
@id("no-dorvane-approval-evidence")
forbid (principal, action == Drupe::Action::"Dorvane___get_approval", resource);
