// Read-only lookups, including both approval lookups.
// Quorvex___get_approval must be permitted, or its completed calls would never be recorded as responses.
@id("read-lookups")
permit (principal, action in [
    Drupe::Action::"MaintData___get_failure_codes",
    Drupe::Action::"MaintData___get_my_assigned_workorders",
    Drupe::Action::"MaintData___get_schedule_calendar",
    Drupe::Action::"MaintData___get_workorder",
    Drupe::Action::"MaintData___get_workorder_actuals_vs_planned",
    Drupe::Action::"MaintData___get_workorder_costs",
    Drupe::Action::"MaintData___get_workorder_kpis",
    Drupe::Action::"MaintData___get_workorder_tasks",
    Drupe::Action::"MaintData___list_workorders",
    Drupe::Action::"Lunvick___get_approval",
    Drupe::Action::"Quorvex___get_approval"
], resource);

// Close only at MAIN, and only with a completed Quorvex approval lookup from this session, within the last hour.
// The lookup must be for the same site and work order, with decision ACCEPTED and approver_kind PERSON.
// Lunvick___get_approval is deliberately not trusted for closing: its string vocabulary is undocumented.
@id("close-at-main-with-person-approval")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Quorvex___get_approval"::response{
    eventResource: resource,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::Quorvex___get_approval_Output_decision::"ACCEPTED",
    output.approver_kind: Drupe::Quorvex___get_approval_Output_approver_kind::"PERSON"
  }
};

// The agent never approves work orders itself. There is no permit for approve_workorder; this forbid makes that explicit.
@id("never-approve")
forbid (principal, action == Drupe::Action::"MaintData___approve_workorder", resource);
