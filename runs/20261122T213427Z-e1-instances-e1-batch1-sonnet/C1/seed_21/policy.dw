// Read-only approval lookups. They must be permitted so that their
// responses are recorded and can be used as evidence by the close policies.
@id("allow_kelvora_get_approval")
permit (principal, action == Drupe::Action::"Kelvora___get_approval", resource);

@id("allow_nimbrel_get_approval")
permit (principal, action == Drupe::Action::"Nimbrel___get_approval", resource);

// Close at MAIN only, backed by a completed Kelvora lookup within the last hour.
// The lookup must confirm a GRANTED decision by a HUMAN approver for the same
// work order and site.
@id("close_workorder_main_with_human_approval_kelvora")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Kelvora___get_approval"::response{
    eventResource: resource,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"GRANTED",
    output.approver_kind: Drupe::approver_kind::"HUMAN"
  }
};

// Same as above, backed by a completed Nimbrel lookup.
@id("close_workorder_main_with_human_approval_nimbrel")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Nimbrel___get_approval"::response{
    eventResource: resource,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"GRANTED",
    output.approver_kind: Drupe::approver_kind::"HUMAN"
  }
};

// The agent must never approve work orders itself.
@id("never_approve_workorder")
forbid (principal, action == Drupe::Action::"MaintData___approve_workorder", resource);
