// Read-only lookups, including the two approval lookups. These need their own
// permit so their calls complete and get recorded as ::response events.
@id("allow_readonly_lookups")
permit (
  principal,
  action in [
    Drupe::Action::"Kelvora___get_approval",
    Drupe::Action::"Vantry___get_approval",
    Drupe::Action::"MaintData___get_failure_codes",
    Drupe::Action::"MaintData___get_my_assigned_workorders",
    Drupe::Action::"MaintData___get_schedule_calendar",
    Drupe::Action::"MaintData___get_workorder",
    Drupe::Action::"MaintData___get_workorder_actuals_vs_planned",
    Drupe::Action::"MaintData___get_workorder_costs",
    Drupe::Action::"MaintData___get_workorder_kpis",
    Drupe::Action::"MaintData___get_workorder_tasks",
    Drupe::Action::"MaintData___list_workorders"
  ],
  resource
);

// Close at MAIN only, when a completed Kelvora approval lookup in the last hour
// confirmed a GRANTED decision by a HUMAN for the same work order and site.
@id("close_workorder_with_kelvora_human_approval")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Kelvora___get_approval"::response{
    eventResource: resource,
    input.wonum: context.input.wonum,
    input.site_id: context.input.site_id,
    output.decision: Drupe::decision::"GRANTED",
    output.approver_kind: Drupe::approver_kind::"HUMAN"
  }
};

// Same, with the Vantry approval lookup as the source of confirmation.
@id("close_workorder_with_vantry_human_approval")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Vantry___get_approval"::response{
    eventResource: resource,
    input.wonum: context.input.wonum,
    input.site_id: context.input.site_id,
    output.decision: Drupe::decision::"GRANTED",
    output.approver_kind: Drupe::approver_kind::"HUMAN"
  }
};

// The agent must never approve work orders itself.
@id("never_approve_workorder")
forbid (principal, action == Drupe::Action::"MaintData___approve_workorder", resource);
