// Close a work order at MAIN only when a person's ACCEPTED approval for the same
// work order and site was confirmed by a completed lookup in this session within the last hour.
// There is one policy per approval-lookup target, because a temporal block cannot use `||`.

@id("close_workorder_main_approved_via_lunvick")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Lunvick___get_approval"::response{
    eventResource: resource,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"ACCEPTED",
    output.approver_kind: Drupe::approver_kind::"PERSON"
  }
};

@id("close_workorder_main_approved_via_vantry")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Vantry___get_approval"::response{
    eventResource: resource,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"ACCEPTED",
    output.approver_kind: Drupe::approver_kind::"PERSON"
  }
};

// Read-only lookups. These must be permitted so their responses are recorded and can
// serve as the confirming approval event.
@id("allow_lookup_lunvick_get_approval")
permit (principal, action == Drupe::Action::"Lunvick___get_approval", resource);

@id("allow_lookup_vantry_get_approval")
permit (principal, action == Drupe::Action::"Vantry___get_approval", resource);

@id("allow_read_get_workorder")
permit (principal, action == Drupe::Action::"MaintData___get_workorder", resource);

@id("allow_read_list_workorders")
permit (principal, action == Drupe::Action::"MaintData___list_workorders", resource);

@id("allow_read_get_workorder_tasks")
permit (principal, action == Drupe::Action::"MaintData___get_workorder_tasks", resource);

@id("allow_read_get_workorder_costs")
permit (principal, action == Drupe::Action::"MaintData___get_workorder_costs", resource);

@id("allow_read_get_workorder_actuals_vs_planned")
permit (principal, action == Drupe::Action::"MaintData___get_workorder_actuals_vs_planned", resource);

@id("allow_read_get_workorder_kpis")
permit (principal, action == Drupe::Action::"MaintData___get_workorder_kpis", resource);

@id("allow_read_get_schedule_calendar")
permit (principal, action == Drupe::Action::"MaintData___get_schedule_calendar", resource);

@id("allow_read_get_my_assigned_workorders")
permit (principal, action == Drupe::Action::"MaintData___get_my_assigned_workorders", resource);

@id("allow_read_get_failure_codes")
permit (principal, action == Drupe::Action::"MaintData___get_failure_codes", resource);

// The agent may never approve work orders itself, whatever else is permitted.
@id("never_approve_workorder")
forbid (principal, action == Drupe::Action::"MaintData___approve_workorder", resource);
