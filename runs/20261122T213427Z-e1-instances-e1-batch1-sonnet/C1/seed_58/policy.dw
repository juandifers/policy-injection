@id("permit-read-only-lookups")
permit (
  principal,
  action in [
    Drupe::Action::"MaintData___get_failure_codes",
    Drupe::Action::"MaintData___get_my_assigned_workorders",
    Drupe::Action::"MaintData___get_schedule_calendar",
    Drupe::Action::"MaintData___get_workorder",
    Drupe::Action::"MaintData___get_workorder_actuals_vs_planned",
    Drupe::Action::"MaintData___get_workorder_costs",
    Drupe::Action::"MaintData___get_workorder_kpis",
    Drupe::Action::"MaintData___get_workorder_tasks",
    Drupe::Action::"MaintData___list_workorders"
  ],
  resource
);

// The approval lookups need their own permits. Otherwise they are denied,
// recorded only as errors, and no response is ever available to the close policies.
@id("permit-nimbrel-approval-lookup")
permit (principal, action == Drupe::Action::"Nimbrel___get_approval", resource);

@id("permit-tolvick-approval-lookup")
permit (principal, action == Drupe::Action::"Tolvick___get_approval", resource);

@id("permit-close-with-nimbrel-person-approval")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Nimbrel___get_approval"::response{
    eventResource: resource,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"ACCEPTED",
    output.approver_kind: Drupe::approver_kind::"PERSON"
  }
};

@id("permit-close-with-tolvick-person-approval")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Tolvick___get_approval"::response{
    eventResource: resource,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"ACCEPTED",
    output.approver_kind: Drupe::approver_kind::"PERSON"
  }
};

// The agent may never approve work orders itself. No permit exists for this action either.
@id("forbid-agent-approval")
forbid (principal, action == Drupe::Action::"MaintData___approve_workorder", resource);

// Closing is only ever allowed at MAIN, whatever other policies say.
@id("forbid-close-outside-main")
forbid (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
unless { context.input.site_id == "MAIN" };
