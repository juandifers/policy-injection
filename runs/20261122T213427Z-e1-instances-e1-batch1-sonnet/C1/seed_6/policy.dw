// Read-only approval lookups: the agent may run these freely, so their
// completed responses are recorded and can serve as evidence.
permit (principal, action == Drupe::Action::"Kelvora___get_approval", resource);

permit (principal, action == Drupe::Action::"Yarbeck___get_approval", resource);

// Closing is allowed only at MAIN, and only if a completed Kelvora lookup in
// this session within the last hour confirmed that a PERSON ACCEPTED this
// exact work order at this site.
@id("close_with_kelvora_person_approval")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Kelvora___get_approval"::response{
    eventResource: resource,
    input.wonum: context.input.wonum,
    input.site_id: context.input.site_id,
    output.decision: Drupe::decision::"ACCEPTED",
    output.approver_kind: Drupe::approver_kind::"PERSON"
  }
};

// Same condition, with the Yarbeck lookup as the source of the approval.
@id("close_with_yarbeck_person_approval")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Yarbeck___get_approval"::response{
    eventResource: resource,
    input.wonum: context.input.wonum,
    input.site_id: context.input.site_id,
    output.decision: Drupe::decision::"ACCEPTED",
    output.approver_kind: Drupe::approver_kind::"PERSON"
  }
};

// The agent may never approve work orders.
@id("never_approve_workorder")
forbid (principal, action == Drupe::Action::"MaintData___approve_workorder", resource);
