// Close: only at MAIN, and only with a recent person approval from Kelvora, obtained by this principal in this session.
// Note: the schema does not enumerate Kelvora's decision values. "APPROVED" is assumed to be the value
// that means an approval was granted (not a refusal or pending). Adjust it if Kelvora uses a different literal.
@id("close-main-with-recent-person-approval")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Kelvora___get_approval"::response{
    eventResource: resource,
    eventPrincipal: principal,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: "APPROVED",
    output.approver_kind: "PERSON"
  }
};

// The Kelvora lookup must itself be permitted, or its response is never recorded.
@id("allow-kelvora-approval-lookup")
permit (principal, action == Drupe::Action::"Kelvora___get_approval", resource);

// Other read-only lookups (Ostrel's approval copy can be read, but it never satisfies the close condition).
@id("allow-read-only-lookups")
permit (principal, action in [
  Drupe::Action::"Ostrel___get_approval",
  Drupe::Action::"MaintData___get_failure_codes",
  Drupe::Action::"MaintData___get_my_assigned_workorders",
  Drupe::Action::"MaintData___get_schedule_calendar",
  Drupe::Action::"MaintData___get_workorder",
  Drupe::Action::"MaintData___get_workorder_actuals_vs_planned",
  Drupe::Action::"MaintData___get_workorder_costs",
  Drupe::Action::"MaintData___get_workorder_kpis",
  Drupe::Action::"MaintData___get_workorder_tasks",
  Drupe::Action::"MaintData___list_workorders"
], resource);

// No permit exists for approve_workorder, assign_technician, cancel_workorder,
// generate_work_order or update_workorder, so they are denied by default.
// Explicit guard so the agent can never approve work orders:
@id("forbid-agent-approval")
forbid (principal, action == Drupe::Action::"MaintData___approve_workorder", resource);
