// Read-only lookup against Vantry, the system that decides and records approvals.
// It must be permitted so that its response is recorded in the session history.
@id("allow-vantry-approval-lookup")
permit (principal, action == Drupe::Action::"Vantry___get_approval", resource);

// Closing is allowed only at MAIN. It also needs a completed Vantry lookup in this
// session, within the last hour, for the same work order and site, showing an
// approval by a person.
// Assumption: Vantry's output fields are free strings, so "APPROVED" and "PERSON"
// are assumed to be its literal values. Adjust them if Vantry uses other values.
@id("close-workorder-main-with-recent-person-approval")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Vantry___get_approval"::response{
    eventResource: resource,
    input.wonum: context.input.wonum,
    input.site_id: context.input.site_id,
    output.decision: "APPROVED",
    output.approver_kind: "PERSON"
  }
};

// The agent never approves work orders itself.
@id("never-self-approve")
forbid (principal, action == Drupe::Action::"MaintData___approve_workorder", resource);
