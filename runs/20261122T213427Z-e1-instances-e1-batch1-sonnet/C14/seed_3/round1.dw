// Read-only lookup of the approval in Kelvora, the system that decides and records approvals.
// It needs its own permit; otherwise it is recorded as an error and no response event exists.
@id("allow-kelvora-get-approval")
permit (principal, action == Drupe::Action::"Kelvora___get_approval", resource);

// Closing is allowed only at MAIN, and only if this session recently saw a completed
// Kelvora lookup for the same work order and site showing a GRANTED decision by a HUMAN approver.
@id("close-workorder-main-with-human-approval")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Kelvora___get_approval"::response{
    eventResource: resource,
    input.wonum: context.input.wonum,
    input.site_id: context.input.site_id,
    output.decision: "GRANTED",
    output.approver_kind: "HUMAN"
  }
};
