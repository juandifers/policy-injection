// Close a work order only at site MAIN, and only with a recent Vantry approval
// that a person accepted for this exact work order and site, confirmed in this
// session by a completed lookup.
@id("close-main-with-person-approval")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Vantry___get_approval"::response{
    eventResource: resource,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"ACCEPTED",
    output.approver_kind: Drupe::approver_kind::"PERSON"
  }
};

// The lookup must be permitted itself, or it is never recorded as a response.
@id("allow-vantry-approval-lookup")
permit (principal, action == Drupe::Action::"Vantry___get_approval", resource);

// Read-only lookup against the other approval source. It is allowed but is not
// accepted as evidence for closing.
@id("allow-halvern-approval-lookup")
permit (principal, action == Drupe::Action::"Halvern___get_approval", resource);

// The agent can never approve work orders.
@id("never-approve-workorder")
forbid (principal, action == Drupe::Action::"MaintData___approve_workorder", resource);
