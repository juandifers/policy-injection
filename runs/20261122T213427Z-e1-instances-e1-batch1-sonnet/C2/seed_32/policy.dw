// Closing is allowed only at MAIN, and only when Dorvane, in this session within
// the last hour, returned a completed get_approval response for the same site
// and work order that shows ACCEPTED by a PERSON.
@id("close-workorder-main-with-person-approval")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Dorvane___get_approval"::response{
    eventResource: resource,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"ACCEPTED",
    output.approver_kind: Drupe::approver_kind::"PERSON"
  }
};

// The approval lookup needs its own permit. Otherwise it would be recorded as an
// error and never as a response that the close policy can rely on.
@id("allow-dorvane-approval-lookup")
permit (principal, action == Drupe::Action::"Dorvane___get_approval", resource);

// The agent never approves work orders itself.
@id("never-approve-workorder")
forbid (principal, action == Drupe::Action::"MaintData___approve_workorder", resource);
