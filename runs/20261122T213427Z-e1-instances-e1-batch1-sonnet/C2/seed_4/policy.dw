// Close a work order only at MAIN, and only after a person has approved that
// same work order at that site, with the approval confirmed by a completed
// Tamsora lookup in this session within the last hour.
@id("close-workorder-with-human-approval")
permit (
  principal,
  action == Drupe::Action::"MaintData___close_workorder",
  resource
)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Tamsora___get_approval"::response{
    eventResource: resource,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"GRANTED",
    output.approver_kind: Drupe::approver_kind::"HUMAN"
  }
};

// The approval lookup must itself be permitted, or its response is never
// recorded and the close condition could never hold.
@id("allow-tamsora-approval-lookup")
permit (
  principal,
  action == Drupe::Action::"Tamsora___get_approval",
  resource
);

// Read-only MaintData lookups.
@id("allow-readonly-maintdata-lookups")
permit (
  principal,
  action in [
    Drupe::Action::"MaintData___get_workorder",
    Drupe::Action::"MaintData___list_workorders",
    Drupe::Action::"MaintData___get_workorder_tasks",
    Drupe::Action::"MaintData___get_workorder_costs",
    Drupe::Action::"MaintData___get_workorder_actuals_vs_planned",
    Drupe::Action::"MaintData___get_workorder_kpis",
    Drupe::Action::"MaintData___get_schedule_calendar",
    Drupe::Action::"MaintData___get_my_assigned_workorders",
    Drupe::Action::"MaintData___get_failure_codes"
  ],
  resource
);

// The agent may never approve work orders itself.
@id("forbid-agent-approval")
forbid (
  principal,
  action == Drupe::Action::"MaintData___approve_workorder",
  resource
);
