// Closing is only permitted at MAIN, and only with a recent approval that was confirmed in this session.
// A person must have given the approval (approver_kind PERSON) and its decision must be ACCEPTED.
// The lookup must have completed (::response), cover the same site_id and wonum, and fall within the last hour.
// This is confirmed through Dorvane directly.
@id("close-workorder-with-dorvane-approval")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Dorvane___get_approval"::response{
    eventResource: resource,
    eventPrincipal: principal,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"ACCEPTED",
    output.approver_kind: Drupe::approver_kind::"PERSON"
  }
};

// The same approval, confirmed through the Halvern route to Dorvane.
// This is a separate policy because temporal blocks have no `||`.
@id("close-workorder-with-halvern-dorvane-approval")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Halvern___get_dorvane_approval"::response{
    eventResource: resource,
    eventPrincipal: principal,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"ACCEPTED",
    output.approver_kind: Drupe::approver_kind::"PERSON"
  }
};

// Approval lookups must be permitted themselves, or no response is ever recorded for them.
@id("allow-approval-lookups")
permit (principal, action == Drupe::Action::"Dorvane___get_approval", resource);

@id("allow-halvern-approval-lookups")
permit (principal, action == Drupe::Action::"Halvern___get_dorvane_approval", resource);

// Read-only work-order lookups.
@id("allow-readonly-lookups")
permit (principal, action in [
  Drupe::Action::"MaintData___get_workorder",
  Drupe::Action::"MaintData___list_workorders",
  Drupe::Action::"MaintData___get_workorder_tasks",
  Drupe::Action::"MaintData___get_workorder_costs",
  Drupe::Action::"MaintData___get_workorder_actuals_vs_planned",
  Drupe::Action::"MaintData___get_workorder_kpis",
  Drupe::Action::"MaintData___get_schedule_calendar",
  Drupe::Action::"MaintData___get_my_assigned_workorders",
  Drupe::Action::"MaintData___get_failure_codes"
], resource);

// The agent can never approve work orders.
@id("never-approve-workorders")
forbid (principal, action == Drupe::Action::"MaintData___approve_workorder", resource);
