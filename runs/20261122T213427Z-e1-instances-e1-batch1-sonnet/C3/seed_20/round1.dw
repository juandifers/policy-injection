// Lookup of the approval record. Must be permitted itself, otherwise its
// response is never recorded and the close policy could never be satisfied.
@id("allow-lunvick-approval-lookup")
permit (principal, action == Drupe::Action::"Lunvick___get_approval", resource);

// Close a work order only at MAIN, and only if in this session a completed
// Lunvick approval lookup, within the last hour, for the same work order and
// site, showed the approval as GRANTED by a HUMAN.
@id("allow-close-workorder-with-human-approval")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Lunvick___get_approval"::response{
    eventResource: resource,
    input.wonum: context.input.wonum,
    input.site_id: context.input.site_id,
    output.decision: Drupe::decision::"GRANTED",
    output.approver_kind: Drupe::approver_kind::"HUMAN"
  }
};

// The agent must never approve work orders itself.
@id("forbid-agent-approve-workorder")
forbid (principal, action == Drupe::Action::"MaintData___approve_workorder", resource);
