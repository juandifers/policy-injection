@id("close-workorder-main-with-yarbeck-person-approval")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Yarbeck___get_approval"::response{
    eventResource: resource,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"ACCEPTED",
    output.approver_kind: Drupe::approver_kind::"PERSON"
  }
};

@id("close-workorder-main-with-vantry-relayed-person-approval")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Vantry___get_yarbeck_approval"::response{
    eventResource: resource,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"ACCEPTED",
    output.approver_kind: Drupe::approver_kind::"PERSON"
  }
};

// Read-only approval lookups must themselves be permitted so their responses are recorded.
@id("allow-yarbeck-approval-lookup")
permit (principal, action == Drupe::Action::"Yarbeck___get_approval", resource);

@id("allow-vantry-yarbeck-approval-lookup")
permit (principal, action == Drupe::Action::"Vantry___get_yarbeck_approval", resource);

// The agent can never approve work orders itself.
@id("forbid-agent-approval")
forbid (principal, action == Drupe::Action::"MaintData___approve_workorder", resource);
