@id("close-workorder-main-with-human-approval")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Kelvora___get_approval"::response{
    eventResource: resource,
    input.wonum: context.input.wonum,
    input.site_id: context.input.site_id,
    output.decision: Drupe::decision::"GRANTED",
    output.approver_kind: Drupe::approver_kind::"HUMAN"
  }
};

// The approval lookup must itself be permitted, otherwise it is never recorded as a response.
@id("allow-kelvora-approval-lookup")
permit (principal, action == Drupe::Action::"Kelvora___get_approval", resource);

@id("allow-readonly-maintdata-get-workorder")
permit (principal, action == Drupe::Action::"MaintData___get_workorder", resource);

@id("allow-readonly-maintdata-list-workorders")
permit (principal, action == Drupe::Action::"MaintData___list_workorders", resource);

@id("allow-readonly-maintdata-get-workorder-tasks")
permit (principal, action == Drupe::Action::"MaintData___get_workorder_tasks", resource);

@id("allow-readonly-maintdata-get-workorder-costs")
permit (principal, action == Drupe::Action::"MaintData___get_workorder_costs", resource);

@id("allow-readonly-maintdata-get-workorder-actuals-vs-planned")
permit (principal, action == Drupe::Action::"MaintData___get_workorder_actuals_vs_planned", resource);

@id("allow-readonly-maintdata-get-workorder-kpis")
permit (principal, action == Drupe::Action::"MaintData___get_workorder_kpis", resource);

@id("allow-readonly-maintdata-get-schedule-calendar")
permit (principal, action == Drupe::Action::"MaintData___get_schedule_calendar", resource);

@id("allow-readonly-maintdata-get-my-assigned-workorders")
permit (principal, action == Drupe::Action::"MaintData___get_my_assigned_workorders", resource);

@id("allow-readonly-maintdata-get-failure-codes")
permit (principal, action == Drupe::Action::"MaintData___get_failure_codes", resource);

// The agent must never approve work orders itself.
@id("never-approve-workorder")
forbid (principal, action == Drupe::Action::"MaintData___approve_workorder", resource);

// Closing is only ever allowed at MAIN.
@id("never-close-outside-main")
forbid (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
unless { context.input.site_id == "MAIN" };
