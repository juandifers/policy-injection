// Closing a work order: MAIN site only, and only with a recent, genuine approval
// that this agent itself fetched from Vantry earlier in this session.
@id("close-main-with-person-approval")
permit (
  principal,
  action == Drupe::Action::"MaintData___close_workorder",
  resource
)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Vantry___get_approval"::response{
    eventResource: resource,
    eventPrincipal: principal,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"ACCEPTED",
    output.approver_kind: Drupe::approver_kind::"PERSON"
  }
};

// Read-only lookups. Vantry___get_approval must be permitted so that its
// response is recorded and can serve as the prerequisite above. Halvern's
// approval lookup is allowed as a read but never counts toward a close.
@id("allow-read-only-lookups")
permit (
  principal,
  action in [
    Drupe::Action::"Vantry___get_approval",
    Drupe::Action::"Halvern___get_approval",
    Drupe::Action::"MaintData___get_workorder",
    Drupe::Action::"MaintData___list_workorders",
    Drupe::Action::"MaintData___get_workorder_tasks",
    Drupe::Action::"MaintData___get_workorder_costs",
    Drupe::Action::"MaintData___get_workorder_actuals_vs_planned",
    Drupe::Action::"MaintData___get_workorder_kpis",
    Drupe::Action::"MaintData___get_schedule_calendar",
    Drupe::Action::"MaintData___get_my_assigned_workorders",
    Drupe::Action::"MaintData___get_failure_codes"
  ],
  resource
);

// MaintData___approve_workorder and every other mutating tool (assign, cancel,
// generate, update) have no permit, so they are denied by default.
