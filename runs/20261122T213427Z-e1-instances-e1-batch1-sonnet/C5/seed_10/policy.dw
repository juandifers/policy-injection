// Reading Vantry approvals is the only lookup permitted. The close policy depends on its
// completed response, so it needs its own permit or it would only be recorded as an error.
@id("allow-vantry-approval-lookup")
permit (principal, action == Drupe::Action::"Vantry___get_approval", resource);

// Close a work order only at MAIN, and only if in this session Vantry returned an
// ACCEPTED decision by a PERSON for this exact site and work order within the last hour.
@id("close-main-with-person-approval")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Vantry___get_approval"::response{
    eventResource: resource,
    eventPrincipal: principal,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::decision::"ACCEPTED",
    output.approver_kind: Drupe::approver_kind::"PERSON"
  }
};

// The agent must never approve work orders itself, whatever else is permitted.
@id("never-self-approve")
forbid (principal, action == Drupe::Action::"MaintData___approve_workorder", resource);
