// Closing: only at MAIN, and only with a recent human approval from Tamsora
// that this principal fetched in this session and that was GRANTED for this same work order and site.
@id("close-workorder-main-with-human-approval")
permit (
  principal,
  action == Drupe::Action::"MaintData___close_workorder",
  resource
)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Tamsora___get_approval"::response{
    eventResource: resource,
    eventPrincipal: principal,
    input.wonum: context.input.wonum,
    input.site_id: context.input.site_id,
    output.decision: "GRANTED",
    output.approver_kind: "HUMAN"
  }
};

// The Tamsora approval lookup must itself be permitted, or its response is never recorded.
@id("allow-tamsora-approval-lookup")
permit (
  principal,
  action == Drupe::Action::"Tamsora___get_approval",
  resource
);

// Other read-only lookups. The Kelvora view of an approval is allowed as a lookup
// but does not satisfy the close policy.
@id("allow-read-only-lookups")
permit (
  principal,
  action in [
    Drupe::Action::"Kelvora___get_tamsora_approval",
    Drupe::Action::"MaintData___get_failure_codes",
    Drupe::Action::"MaintData___get_my_assigned_workorders",
    Drupe::Action::"MaintData___get_schedule_calendar",
    Drupe::Action::"MaintData___get_workorder",
    Drupe::Action::"MaintData___get_workorder_actuals_vs_planned",
    Drupe::Action::"MaintData___get_workorder_costs",
    Drupe::Action::"MaintData___get_workorder_kpis",
    Drupe::Action::"MaintData___get_workorder_tasks",
    Drupe::Action::"MaintData___list_workorders"
  ],
  resource
);

// Defense in depth: the agent never approves work orders itself.
@id("forbid-agent-approve-workorder")
forbid (
  principal,
  action == Drupe::Action::"MaintData___approve_workorder",
  resource
);
