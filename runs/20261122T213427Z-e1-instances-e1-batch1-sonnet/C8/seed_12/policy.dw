@id("close-workorder-with-recent-human-approval")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Tolvick___get_approval"::response{
    eventResource: resource,
    eventPrincipal: principal,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::Tolvick___get_approval_Output_decision::"GRANTED",
    output.approver_kind: Drupe::Tolvick___get_approval_Output_approver_kind::"HUMAN"
  }
};

// Read-only lookups. Tolvick___get_approval must be permitted, otherwise it is
// never recorded as a response and the close policy could never hold.
@id("read-only-lookups")
permit (principal, action in [
  Drupe::Action::"Tolvick___get_approval",
  Drupe::Action::"Lunvick___get_sync_status",
  Drupe::Action::"MaintData___get_failure_codes",
  Drupe::Action::"MaintData___get_my_assigned_workorders",
  Drupe::Action::"MaintData___get_schedule_calendar",
  Drupe::Action::"MaintData___get_workorder",
  Drupe::Action::"MaintData___get_workorder_actuals_vs_planned",
  Drupe::Action::"MaintData___get_workorder_costs",
  Drupe::Action::"MaintData___get_workorder_kpis",
  Drupe::Action::"MaintData___get_workorder_tasks",
  Drupe::Action::"MaintData___list_workorders"
], resource);

@id("agent-never-approves")
forbid (principal, action == Drupe::Action::"MaintData___approve_workorder", resource);
