// Closing: MAIN site only, and only after a completed approval lookup in this
// session, within the last hour, that returned GRANTED from a HUMAN approver
// for the same work order and site. Two approval sources exist (Dorvane and
// Vantry), and temporal blocks have no `||`, so there is one permit per source.

@id("close-after-human-approval-dorvane")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Dorvane___get_approval"::response{
    eventResource: resource,
    input.wonum: context.input.wonum,
    input.site_id: context.input.site_id,
    output.decision: Drupe::Dorvane___get_approval_Output_decision::"GRANTED",
    output.approver_kind: Drupe::Dorvane___get_approval_Output_approver_kind::"HUMAN"
  }
};

@id("close-after-human-approval-vantry")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Vantry___get_approval"::response{
    eventResource: resource,
    input.wonum: context.input.wonum,
    input.site_id: context.input.site_id,
    output.decision: "GRANTED",
    output.approver_kind: "HUMAN"
  }
};

// Approval lookups must themselves be permitted, or their responses are never recorded.
@id("allow-dorvane-get-approval")
permit (principal, action == Drupe::Action::"Dorvane___get_approval", resource);

@id("allow-vantry-get-approval")
permit (principal, action == Drupe::Action::"Vantry___get_approval", resource);

// Other read-only lookups.
@id("allow-read-only-lookups")
permit (
  principal,
  action in [
    Drupe::Action::"MaintData___get_workorder",
    Drupe::Action::"MaintData___list_workorders",
    Drupe::Action::"MaintData___get_workorder_tasks",
    Drupe::Action::"MaintData___get_workorder_costs",
    Drupe::Action::"MaintData___get_workorder_actuals_vs_planned",
    Drupe::Action::"MaintData___get_workorder_kpis",
    Drupe::Action::"MaintData___get_schedule_calendar",
    Drupe::Action::"MaintData___get_my_assigned_workorders",
    Drupe::Action::"MaintData___get_failure_codes"
  ],
  resource
);

// The agent may never approve work orders itself.
@id("never-approve-workorder")
forbid (principal, action == Drupe::Action::"MaintData___approve_workorder", resource);
