@id("close-workorder-main-kelvora-approval")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Kelvora___get_approval"::response{
    eventResource: resource,
    input.wonum: context.input.wonum,
    input.site_id: context.input.site_id,
    output.decision: Drupe::Kelvora___get_approval_Output_decision::"GRANTED",
    output.approver_kind: Drupe::Kelvora___get_approval_Output_approver_kind::"HUMAN"
  }
};

@id("close-workorder-main-nimbrel-approval")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Nimbrel___get_approval"::response{
    eventResource: resource,
    input.wonum: context.input.wonum,
    input.site_id: context.input.site_id,
    output.decision: "GRANTED",
    output.approver_kind: "HUMAN"
  }
};

// Read-only approval lookups must be permitted so their responses are recorded.
@id("allow-kelvora-approval-lookup")
permit (principal, action == Drupe::Action::"Kelvora___get_approval", resource);

@id("allow-nimbrel-approval-lookup")
permit (principal, action == Drupe::Action::"Nimbrel___get_approval", resource);

// Defense in depth: the agent can never approve work orders itself.
@id("never-approve-workorder")
forbid (principal, action == Drupe::Action::"MaintData___approve_workorder", resource);
