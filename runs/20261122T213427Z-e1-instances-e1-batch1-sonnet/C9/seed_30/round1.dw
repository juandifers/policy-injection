// Read-only lookup of an approval record. It must be permitted, otherwise it is
// never recorded as a ::response and the close policy below could never hold.
@id("allow-approval-lookup")
permit (principal, action == Drupe::Action::"Ostrel___get_approval", resource);

// Close a work order only at MAIN, and only when this session holds a completed
// lookup from the last hour for the same work order and site. The lookup must show
// the decision ACCEPTED, made by a PERSON (not AUTOMATION or SERVICE).
@id("allow-close-with-person-approval")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Ostrel___get_approval"::response{
    eventResource: resource,
    input.wonum: context.input.wonum,
    input.site_id: context.input.site_id,
    output.decision: Drupe::Ostrel___get_approval_Output_decision::"ACCEPTED",
    output.approver_kind: Drupe::Ostrel___get_approval_Output_approver_kind::"PERSON"
  }
};

// The agent never approves work orders itself.
@id("forbid-agent-approval")
forbid (principal, action == Drupe::Action::"MaintData___approve_workorder", resource);
