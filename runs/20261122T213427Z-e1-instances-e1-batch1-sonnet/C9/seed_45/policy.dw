@id("close-workorder-main-with-recent-person-approval")
permit (principal, action == Drupe::Action::"MaintData___close_workorder", resource)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Yarbeck___get_approval"::response{
    eventResource: resource,
    input.site_id: context.input.site_id,
    input.wonum: context.input.wonum,
    output.decision: Drupe::Yarbeck___get_approval_Output_decision::"ACCEPTED",
    output.approver_kind: Drupe::Yarbeck___get_approval_Output_approver_kind::"PERSON"
  }
};

// Read-only lookups. The approval lookup must itself be permitted so that its response is recorded.
@id("allow-yarbeck-get-approval")
permit (principal, action == Drupe::Action::"Yarbeck___get_approval", resource);

@id("allow-nimbrel-get-approval")
permit (principal, action == Drupe::Action::"Nimbrel___get_approval", resource);

@id("allow-get-workorder")
permit (principal, action == Drupe::Action::"MaintData___get_workorder", resource);

@id("allow-list-workorders")
permit (principal, action == Drupe::Action::"MaintData___list_workorders", resource);

@id("allow-get-my-assigned-workorders")
permit (principal, action == Drupe::Action::"MaintData___get_my_assigned_workorders", resource);

@id("allow-get-workorder-tasks")
permit (principal, action == Drupe::Action::"MaintData___get_workorder_tasks", resource);

@id("allow-get-workorder-costs")
permit (principal, action == Drupe::Action::"MaintData___get_workorder_costs", resource);

@id("allow-get-workorder-actuals-vs-planned")
permit (principal, action == Drupe::Action::"MaintData___get_workorder_actuals_vs_planned", resource);

@id("allow-get-workorder-kpis")
permit (principal, action == Drupe::Action::"MaintData___get_workorder_kpis", resource);

@id("allow-get-schedule-calendar")
permit (principal, action == Drupe::Action::"MaintData___get_schedule_calendar", resource);

@id("allow-get-failure-codes")
permit (principal, action == Drupe::Action::"MaintData___get_failure_codes", resource);
