// Read-only lookups. Wexlow___get_approval needs its own permit so that its
// successful calls are recorded as responses and can satisfy the close policy below.
@id("allow-readonly-lookups")
permit (
  principal,
  action in [
    Drupe::Action::"MaintData___get_failure_codes",
    Drupe::Action::"MaintData___get_my_assigned_workorders",
    Drupe::Action::"MaintData___get_schedule_calendar",
    Drupe::Action::"MaintData___get_workorder",
    Drupe::Action::"MaintData___get_workorder_actuals_vs_planned",
    Drupe::Action::"MaintData___get_workorder_costs",
    Drupe::Action::"MaintData___get_workorder_kpis",
    Drupe::Action::"MaintData___get_workorder_tasks",
    Drupe::Action::"MaintData___list_workorders",
    Drupe::Action::"Lunvick___get_approval",
    Drupe::Action::"Wexlow___get_approval"
  ],
  resource
);

// Closing is allowed only at MAIN, and only if, within the last hour of this
// session, a completed approval lookup for the same work order and site
// returned GRANTED from a HUMAN approver.
@id("allow-close-workorder-with-human-approval")
permit (
  principal,
  action == Drupe::Action::"MaintData___close_workorder",
  resource
)
when { context.input.site_id == "MAIN" }
when temporal {
  formerly within 1h Drupe::Action::"Wexlow___get_approval"::response{
    eventResource: resource,
    input.wonum: context.input.wonum,
    input.site_id: context.input.site_id,
    output.decision: Drupe::Wexlow___get_approval_Output_decision::"GRANTED",
    output.approver_kind: Drupe::Wexlow___get_approval_Output_approver_kind::"HUMAN"
  }
};

// The agent may never approve work orders itself.
@id("forbid-agent-approval")
forbid (
  principal,
  action == Drupe::Action::"MaintData___approve_workorder",
  resource
);
